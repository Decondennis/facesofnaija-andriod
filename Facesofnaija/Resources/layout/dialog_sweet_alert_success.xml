<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:background="@drawable/dialog_card_background">

    <!-- Success Circular Icon -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/circle_success_badge_green"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_dialog_check_white"
            android:contentDescription="Success" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verification Email Sent!"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <!-- Dialog Message -->
    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registration successful! We have sent a verification link to your email. Please check your inbox or spam folder to activate your account."
        android:textSize="14sp"
        android:textColor="#555555"
        android:lineSpacingExtra="3dp"
        android:gravity="center"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="24dp" />

    <!-- OK / Confirm Green Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/dialog_btn_ok"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="OK, Got It"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/btn_sweet_alert_green"
        android:elevation="2dp" />

</LinearLayout>
