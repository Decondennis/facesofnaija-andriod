<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_alignParentTop="true"
    android:layout_marginBottom="0dp"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?attr/colorFill" >
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
                app:theme="@style/ToolbarTheme"
            app:title="@string/Lbl_EditPost"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:titleTextAppearance="@style/Toolbar.TitleText"
            android:background="?attr/colorFill">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Lbl_Save"
                android:textColor="@color/gnt_white"
                android:background="@drawable/round_button_pressed"
                android:layout_gravity="end"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="12dp"
                android:id="@+id/toolbar_title" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="?attr/colorFill">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorFill"
            android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/mainsection"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:gravity="top"
                android:layout_gravity="top"
                android:foregroundGravity="top">
                <ImageView
                    android:id="@+id/postsectionimage"
                    android:scaleType="centerCrop"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="13dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/no_profile_image" />
                <TextView
                    android:id="@+id/card_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="19dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="14dp"
                    android:layout_toEndOf="@id/postsectionimage"
                    android:textSize="15sp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:layout_toEndOf="@id/postsectionimage"
                    android:layout_below="@id/card_name"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:id="@+id/cont"
                    android:textSize="13sp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="5dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/round_button_outline"
                    android:tag="false"
                    android:paddingTop="1dp"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:text="@string/Lbl_Everyone"
                    android:textColor="@color/accent" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.3dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:background="?attr/colorDivider"
                    android:layout_below="@id/postsectionimage" />
            </RelativeLayout>
            <EditText
                android:id="@+id/editTxtEmail"
                android:singleLine="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="5dp"
                android:background="@android:color/transparent"
                android:paddingBottom="5dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:maxLength="5000"
                android:inputType="textMultiLine"
                android:hint="@string/Lbl_Whats_Going_On"
                android:scrollbars="vertical"
                android:textSize="19sp"
                android:scrollHorizontally="false"
                android:maxLines="20"
                android:textAllCaps="false"
                android:gravity="top" />
            <LinearLayout
                android:id="@+id/ll_add_image"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/round_button_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_addpost_image_vector"
                    app:tint="@color/accent" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/Lbl_AddPhotos"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/AttachementRecyler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp" />
            <Facesofnaija.Activities.NativePost.Extra.WRecyclerView
                android:id="@+id/Recyler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>