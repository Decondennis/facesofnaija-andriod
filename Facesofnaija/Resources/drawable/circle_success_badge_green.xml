<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer light green circular background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#E8F5E9" />
            <size android:width="72dp" android:height="72dp" />
            <stroke android:width="3dp" android:color="#A5D6A7" />
        </shape>
    </item>
    <!-- Inner solid green circle -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <solid android:color="#2e7806" />
        </shape>
    </item>
</layer-list>
